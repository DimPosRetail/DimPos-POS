    "version": "0.2.0",
    "configurations": [
        {
            "name": "dimpos_store (Flutter Web)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "deviceId": "chrome",
            "args": [
                "--web-port",
                "5203",
                "--web-renderer",
                "html"
            ],
        },
        {
            "name": "Dart",
            "type": "dart",
            "request": "launch",
            "program": "bin/main.dart"
        },
        {
            "name": "dimpos_store",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "dimpos_store (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "dimpos_store (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}